# Rivanta Green Environment Configuration Template
# Copy to .env.local for local development or set in Vercel / deployment environment.

# Transactional Email Dispatch (Resend)
# RESEND_API_KEY=re_123456789

# Direct Webhook Forwarding (CRM / Slack / Zapier / Custom Endpoint)
# INQUIRY_FORWARD_WEBHOOK_URL=https://api.example.com/inquiries/webhook

# Internal Notification Recipient Email
# CONTACT_NOTIFICATION_EMAIL=info@rivantagreen.com
